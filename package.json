{
  "name": "velbok",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:push": "npx supabase@latest db push",
    "db:link": "npx supabase@latest link --project-ref tkremoxfkgoiuwghtzwd",
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && node scripts/build-logo-icon.mjs && node scripts/copy-release-apk.mjs && vite build",
    "build:analyze": "node scripts/generate-sitemap.mjs && node scripts/build-logo-icon.mjs && vite build --mode analyze",
    "build:icons": "node scripts/prepare-brand-assets.mjs && node scripts/build-logo-icon.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:preview": "npm run build && npx netlify-cli deploy --dir=dist",
    "deploy:preview:only": "npx netlify-cli deploy --dir=dist",
    "deploy:prod": "npm run build && npx netlify-cli deploy --prod --dir=dist --site dc785d32-2796-486d-8a45-93f1ea0a41e3",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/patch-stripe-terminal-android.mjs && node scripts/patch-stripe-terminal-ios.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:sync": "node scripts/patch-stripe-terminal-android.mjs && node scripts/patch-stripe-terminal-ios.mjs && npm run build:mobile && npx cap sync && node scripts/fix-ios-spm-paths.mjs && node scripts/patch-ios-capacitor-config.mjs",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "sync:version": "node scripts/sync-mobile-version.mjs",
    "verify:ios-push": "node scripts/verify-ios-push.mjs",
    "verify:version": "node scripts/verify-mobile-version.mjs",
    "ios:prepare": "node scripts/sync-mobile-version.mjs && npm run build:icons && npm run cap:sync && node scripts/verify-mobile-version.mjs && node scripts/verify-ios-bundle.mjs && node scripts/verify-ios-plugins.mjs && node scripts/verify-ios-push.mjs",
    "ios:reset-signing": "bash scripts/ios-reset-xcode-signing.sh",
    "ios:archive-prep": "bash scripts/ios-archive-prep.sh",
    "ios:fix-profiles-folder": "bash scripts/ios-fix-provisioning-folder.sh",
    "ios:install-profile": "bash scripts/ios-install-provisioning-profile.sh",
    "ios:verify-profiles": "bash scripts/ios-verify-profiles.sh",
    "ios:build-simulator": "bash scripts/ios-build-simulator.sh",
    "ios:doctor": "node scripts/ios-doctor.mjs",
    "ios:build-lite": "node scripts/ios-build-lite.mjs",
    "ios:build-status": "node scripts/ios-build-status.mjs",
    "ios:archive": "bash scripts/ios-archive.sh",
    "ios:export": "bash scripts/ios-export-archive.sh",
    "ios:ipa": "bash scripts/ios-ipa-from-archive.sh",
    "ios:verify-archive": "bash scripts/ios-verify-archive.sh",
    "macincloud:setup": "bash scripts/macincloud-ios-setup.sh",
    "android:bundle": "npm run cap:sync && cd android && gradlew.bat bundleRelease",
    "android:release": "npm run cap:sync && cd android && gradlew.bat assembleRelease"
  },
