# Copy to .env for local dev. Set the same VITE_* vars in your host (Vercel/Netlify) for production.
# Project ref must match the Supabase project where you run migrations and store data.

VITE_SUPABASE_PROJECT_ID=tkremoxfkgoiuwghtzwd
VITE_SUPABASE_URL=https://tkremoxfkgoiuwghtzwd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Platform branding (defaults to Velbok if unset)
VITE_PLATFORM_NAME=Velbok
VITE_PLATFORM_TAGLINE=Tattoo Studio Platform

# Per-shop branding (configure per tenant deployment)
VITE_SHOP_NAME=Velbok
VITE_SHOP_LEGAL_NAME=Inkaholics Limited
VITE_SHOP_TRADING_NAME=Velbok
VITE_SHOP_SUPPORT_EMAIL=support@velbok.com
# Optional — shown subtly on sign-in / recovery screens (e.g. +44 7700 900000)
# VITE_SHOP_SUPPORT_PHONE=
VITE_SHOP_PRIVACY_EMAIL=privacy@velbok.com
VITE_SHOP_DPO_EMAIL=privacy@velbok.com
VITE_SITE_URL=https://velbok.com
VITE_SHOP_WEBSITE_URL=https://velbok.com
# Google Play internal/closed testing opt-in (download page). Use public store URL after launch.
VITE_PLAY_ANDROID_BETA_URL=https://play.google.com/apps/internaltest/4701744591257923713
VITE_SHOP_ADDRESS=
VITE_SHOP_ACCENT_COLOR=#d4af37

# Platform subscription billing (Supabase Edge Function secrets — not VITE_*)
# STRIPE_SECRET_KEY=sk_xxx              # Velbok Co — platform subscriptions
# STRIPE_WEBHOOK_SECRET=whsec_xxx       # Webhook on Velbok Co
# STRIPE_CONNECT_SECRET_KEY=sk_xxx      # Inkaholics Limited — tattoo shop payouts (optional; falls back to STRIPE_SECRET_KEY)
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx  # Webhook on Inkaholics Connect platform (run scripts/setup-stripe-connect-webhook.ps1)
# STRIPE_PRICE_SOLO=price_xxx      # Recurring PRICE id (price_...), NOT product id (prod_...)
# STRIPE_PRICE_STARTER=price_xxx   # Recurring PRICE id (price_...), NOT product id (prod_...)
# STRIPE_PRICE_STUDIO=price_xxx    # Stripe Dashboard → Products → plan → Pricing → copy Price ID
# STRIPE_PRICE_ENTERPRISE=price_xxx # Must match test/live mode of STRIPE_SECRET_KEY (sk_test_ vs sk_live_)
# Optional per-currency prices (when shop billing currency is not GBP):
# STRIPE_PRICE_SOLO_EUR=price_xxx  STRIPE_PRICE_STARTER_EUR=price_xxx  STRIPE_PRICE_STUDIO_EUR=price_xxx  STRIPE_PRICE_ENTERPRISE_EUR=price_xxx
# STRIPE_PRICE_SOLO_USD=price_xxx  STRIPE_PRICE_STARTER_USD=price_xxx  STRIPE_PRICE_STUDIO_USD=price_xxx  STRIPE_PRICE_ENTERPRISE_USD=price_xxx
# Or set stripe_price_id on subscription_plan_prices rows in the database.
# STRIPE_TAX_ENABLED=true            # Stripe Tax on platform checkout (enable Stripe Tax in Dashboard first)
# Platform webhook (Velbok): checkout.session.completed, customer.subscription.*, invoice.payment_failed
# Connect webhook (Inkaholics): checkout.session.completed, account.updated, payment_intent.succeeded
# Stripe Terminal simulated reader in web dev (set false for live WisePad in mobile builds)
# VITE_STRIPE_TERMINAL_TEST_MODE=false

# Google / Apple OAuth (Supabase Auth → Providers; add redirect URLs — see docs below)
# VITE_APPLE_SIGN_IN_ENABLED=true
# Web Client ID (same as Supabase Google provider) — shows "Velbok" in Google picker instead of *.supabase.co
# Add these Authorized JavaScript origins in Google Cloud → Credentials → this OAuth client:
#   https://velbok.com
#   http://localhost:5173
#   https://localhost          (Capacitor Android/iOS WebView)
VITE_GOOGLE_CLIENT_ID=843973604535-hh4010q2pagr6m72esbh9mlddattg65i.apps.googleusercontent.com
# Supabase redirect URLs to allow:
#   https://velbok.com/auth
#   https://velbok.com/subscribe
#   https://velbok.com/embed/customer-login
#   com.velbok.app://auth/callback

# Passwordless sign-in (email magic link is always available; phone OTP optional)
# VITE_PHONE_SIGN_IN_ENABLED=true   # Requires Supabase Auth → Phone provider (Twilio), not Advanced MFA
# TRUSTED_DEVICE_PEPPER=long-random-secret  # Supabase secret for mfa-trusted-device edge function

# AI stencil (Netlify AI Gateway — no manual API key; enable AI in Netlify team settings)

# Vapi voice agent (Supabase Edge Function secret — not VITE_*)
# VAPI_WEBHOOK_SECRET=long-random-secret   # Must match Vapi assistant serverUrlSecret
# Webhook URL: https://tkremoxfkgoiuwghtzwd.supabase.co/functions/v1/vapi-webhook
# See docs/vapi-setup-instructions.md

