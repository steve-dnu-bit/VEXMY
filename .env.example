# Copy to .env for local dev. Set the same VITE_* vars in your host (Vercel/Netlify) for production.
# Project ref must match the Supabase project where you run migrations and store data.

VITE_SUPABASE_PROJECT_ID=tkremoxfkgoiuwghtzwd
VITE_SUPABASE_URL=https://tkremoxfkgoiuwghtzwd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Platform branding (defaults to VexMy if unset)
VITE_PLATFORM_NAME=VexMy
VITE_PLATFORM_TAGLINE=Tattoo Studio Platform

# Per-shop branding (configure per tenant deployment)
VITE_SHOP_NAME=My Tattoo Studio
VITE_SHOP_LEGAL_NAME=My Studio Ltd
VITE_SHOP_TRADING_NAME=My Tattoo Studio
VITE_SHOP_SUPPORT_EMAIL=support@example.com
VITE_SHOP_PRIVACY_EMAIL=privacy@example.com
VITE_SHOP_DPO_EMAIL=dpo@example.com
VITE_SHOP_WEBSITE_URL=https://example.com
VITE_SHOP_ADDRESS=
VITE_SHOP_ACCENT_COLOR=#d4af37

# Optional: comma-separated artist user IDs hidden from schedule dropdown
# VITE_SCHEDULE_HIDDEN_ARTIST_IDS=
