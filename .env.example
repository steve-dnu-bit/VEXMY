# Copy to .env for local dev. Set the same VITE_* vars in your host (Vercel/Netlify) for production.
# Project ref must match the Supabase project where you run migrations and store data.

VITE_SUPABASE_PROJECT_ID=tkremoxfkgoiuwghtzwd
VITE_SUPABASE_URL=https://tkremoxfkgoiuwghtzwd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Platform branding (defaults to Velbok if unset)
VITE_PLATFORM_NAME=Velbok
VITE_PLATFORM_TAGLINE=Tattoo Studio Platform

# Per-shop branding (configure per tenant deployment)
VITE_SHOP_NAME=My Tattoo Studio
VITE_SHOP_LEGAL_NAME=My Studio Ltd
VITE_SHOP_TRADING_NAME=My Tattoo Studio
VITE_SHOP_SUPPORT_EMAIL=support@velbok.com

# Edge function email (set in Supabase secrets — see docs/supabase-secrets-dashboard.md)
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend
#         SMTP_PASS=re_xxx EMAIL_FROM=Velbok <no-reply@velbok.com> SITE_URL=https://velbok.com
# Inbound (velbok.com on free Resend plan): RESEND_WEBHOOK_SECRET=whsec_xxx RESEND_INBOUND_DOMAIN=velbok.com
#         RESEND_INBOUND_FORWARD_TO=you@example.com BOOKINGS_REPLY_TO=bookings@velbok.com
VITE_SHOP_PRIVACY_EMAIL=privacy@example.com
VITE_SHOP_DPO_EMAIL=dpo@example.com
VITE_SITE_URL=https://velbok.com
VITE_SHOP_WEBSITE_URL=https://velbok.com
VITE_SHOP_ADDRESS=
VITE_SHOP_ACCENT_COLOR=#d4af37

# Platform subscription billing (Supabase Edge Function secrets — not VITE_*)
# STRIPE_SECRET_KEY=sk_xxx              # Velbok Co — platform subscriptions
# STRIPE_WEBHOOK_SECRET=whsec_xxx       # Webhook on Velbok Co
# STRIPE_CONNECT_SECRET_KEY=sk_xxx      # Inkaholics Limited — tattoo shop payouts (optional; falls back to STRIPE_SECRET_KEY)
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx  # Webhook on Inkaholics Connect platform (run scripts/setup-stripe-connect-webhook.ps1)
# STRIPE_PRICE_STARTER=price_xxx   # Recurring PRICE id (price_...), NOT product id (prod_...)
# STRIPE_PRICE_STUDIO=price_xxx    # Stripe Dashboard → Products → plan → Pricing → copy Price ID
# STRIPE_PRICE_ENTERPRISE=price_xxx # Must match test/live mode of STRIPE_SECRET_KEY (sk_test_ vs sk_live_)
# Optional per-currency prices (when shop billing currency is not GBP):
# STRIPE_PRICE_STARTER_EUR=price_xxx  STRIPE_PRICE_STUDIO_EUR=price_xxx  STRIPE_PRICE_ENTERPRISE_EUR=price_xxx
# STRIPE_PRICE_STARTER_USD=price_xxx  STRIPE_PRICE_STUDIO_USD=price_xxx  STRIPE_PRICE_ENTERPRISE_USD=price_xxx
# Or set stripe_price_id on subscription_plan_prices rows in the database.
# STRIPE_TAX_ENABLED=true            # Stripe Tax on platform checkout (enable Stripe Tax in Dashboard first)
# Platform webhook (Velbok): checkout.session.completed, customer.subscription.*, invoice.payment_failed
# Connect webhook (Inkaholics): checkout.session.completed, account.updated, payment_intent.succeeded
# Enable Connect in Stripe Dashboard → Settings → Connect. Client payments use Express connected accounts per shop.

