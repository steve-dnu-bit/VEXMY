{
	"appId": "com.velbok.app",
	"appName": "Velbok",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1800,
			"launchAutoHide": true,
			"backgroundColor": "#0c0c0f",
			"showSpinner": false
		}
	},
	"packageClassList": [
		"StripeTerminalPlugin",
		"AppPlugin",
		"SplashScreenPlugin"
	]
}
