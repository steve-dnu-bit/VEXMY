{
	"appId": "com.velbok.app",
	"appName": "Velbok",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"iosScheme": "https"
	},
	"plugins": {
		"SystemBars": {
			"style": "DARK"
		},
		"CapacitorHttp": {
			"enabled": true
		},
		"SplashScreen": {
			"launchShowDuration": 0,
			"launchAutoHide": false,
			"backgroundColor": "#0c0c0f",
			"showSpinner": false
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"BiometricAuthNative",
		"StripeTerminalPlugin",
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"GeolocationPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"TapToPayEducationPlugin",
		"TapToPayReadinessPlugin",
		"TerminalPermissionsPlugin"
	]
}
