# Android release binaries (too large for GitHub; deploy via Netlify CLI from local builds)
releases/*.apk
releases/*.aab
releases/app-versions/apk/
releases/app-versions/aab/
releases/app-versions/ios/*.ipa
public/downloads/*.apk
releases/phone-screenshots/
releases/promo/

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.netlify

# Firebase service account (server push — never commit)
**/*firebase-adminsdk*.json
android/app/*firebase-adminsdk*.json
.firebase-secret.env

# Environment variables (secrets — do not commit)
.env
.env.*
!.env.example

# Play internal tester list (PII — generated locally)
docs/play-internal-testers.txt
docs/play-review-credentials.txt
docs/apple-review-credentials.txt

# Apple TTPOI proprietary materials (local working copies only)
docs/apple-ttpoi/Tap to Pay on iPhone App Requirements/
docs/apple-ttpoi/requirements-extracted.txt
docs/apple-ttpoi/checklist-extracted.txt
docs/apple-ttpoi/extract_requirements.py
docs/apple-ttpoi/*.zip

# Supabase CLI local cache
supabase/.temp/

# Local database dumps (may contain PII; keep outside git)
backups/*.sql
backups/*.json

# Local import dumps (PII; regenerate with scripts/merge_contacts_and_appointments_for_supabase_bookings.py)
import-templates/merged-bookings-supabase.csv
email_list.csv

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.pyc

# i18n locale translation working files (keep only en.json + locale/*.json + docs/*.json)
src/i18n/locales/_*
src/i18n/locales/manual-translations.json
src/i18n/locales/final-overrides.json
src/i18n/locales/batch-translate.mjs
src/i18n/locales/apply-manual-translations.mjs
src/i18n/locales/generate-manual-translations.mjs
